rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This project never uses the Firebase client SDK. Every read/write goes
    // through Next.js API routes using the Firebase Admin SDK, which runs on
    // the server and bypasses these rules entirely. As defense-in-depth, we
    // explicitly deny all direct client access to Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
