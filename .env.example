# Firebase Realtime Database — queue, rate-limit, dedupe, worker lock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=
# Alternative to BASE64:
# FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Server-side upstream only — never use NEXT_PUBLIC_ for this
REACTION_API_URL=https://react.zfile.web.id/api/send-reaction

# Upstream protection
UPSTREAM_TIMEOUT=10000
UPSTREAM_MAX_RETRIES=3

IP_HASH_SALT=

# Anti-spam / global queue
RATE_LIMIT_BURST=2
RATE_LIMIT_PER_MINUTE=6
GLOBAL_RATE_LIMIT_PER_MINUTE=30
QUEUE_MAX_SIZE=250
QUEUE_JOB_TTL=86400
DEDUPE_TTL=45
QUEUE_LOCK_TTL=45

# Cron authentication
CRON_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=

WORKER_BATCH_SIZE=2
