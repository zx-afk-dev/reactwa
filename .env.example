# Server-side reaction service
REACTION_API_URL=https://react.zfile.web.id/api/send-reaction

# Abort the upstream request after this many milliseconds
UPSTREAM_TIMEOUT=10000

# Public site URL
NEXT_PUBLIC_SITE_URL=

# Optional: stable salt for hashing visitor IPs into anonymous user IDs.
# Do not use a public/client-side value here.
IP_HASH_SALT=
