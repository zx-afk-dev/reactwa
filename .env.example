# Persistent global queue (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Proxy target (server-side only; never expose to browser)
REACTION_API_URL=https://react.zfile.web.id/api/send-reaction
UPSTREAM_TIMEOUT=30000
UPSTREAM_MAX_RETRIES=3

# Anti-spam / queue protection
RATE_LIMIT_BURST=2
RATE_LIMIT_PER_MINUTE=6
QUEUE_MAX_SIZE=250
QUEUE_JOB_TTL=86400
DEDUPE_TTL=45
QUEUE_LOCK_TTL=45
IP_HASH_SALT=
CRON_SECRET=

# Public site URL
NEXT_PUBLIC_SITE_URL=
